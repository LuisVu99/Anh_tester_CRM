# ============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file, rename it to .env, and fill in your actual values.
# DO NOT COMMIT THE ACTUAL .env FILE TO GITHUB.
# ============================================================================

# Environment URLs
DEV_BASE_URL=https://dev.example.com
STAGING_BASE_URL=https://staging.example.com
PROD_BASE_URL=https://prod.example.com

# Staging Credentials
STAGING_USERNAME=your_staging_username@example.com
STAGING_PASSWORD=your_staging_password

# Admin Credentials (for local testing)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password
ADMIN_USERNAME=your_admin_username

# Standard User Credentials (for local testing)
USER_FULL_NAME="Your User Full Name"
USER_PASSWORD=your_user_password
USER_USERNAME=your_user_username